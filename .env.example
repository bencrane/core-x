# core-x — Gen-3 data-plane environment variables.
#
# The authoritative source is Doppler + Modal Secrets, NOT a committed .env.
# This file documents variable names for local/debug runs only. Runtime wiring:
#   - Trigger.dev task env (control plane): MODAL_DISPATCHER_URL, MODAL_KEY, MODAL_SECRET
#   - Modal secret "r2-credentials" (worker → R2):    R2_*
#   - Modal secret "hqx-postgres"   (worker → ops.*): HQX_DB_URL_POOLED

# ── Control plane → Universal Dispatcher (set in the Trigger project env) ──
# The single proxy-authed Modal endpoint + its proxy-auth token pair.
MODAL_DISPATCHER_URL=
MODAL_KEY=
MODAL_SECRET=

# ── Data plane → Cloudflare R2 (Modal secret: r2-credentials) ──────────────
# Lance system-of-record storage. Supply R2_ENDPOINT directly, or R2_ACCOUNT_ID
# to derive https://<account>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Data plane → Postgres ops.* state (Modal secret: hqx-postgres) ─────────
# Worker writes terminal run rows to ops.sam_opps_canonical_runs (pooled DSN).
# Also consumed by apps/gtm_mcp: ATTACHed to its DuckDB session as the `hqx`
# catalog for hybrid Lance⋈Postgres joins + the ops.* campaign-audience write tools.
HQX_DB_URL_POOLED=

# ── Data plane → DOL Open Data API (Modal secret: dol-api) ─────────────────
# OSHA sniper worker auth. Register at https://dataportal.dol.gov/registration,
# mint a key at https://dataportal.dol.gov/api-keys. Sent as the X-API-KEY header.
# The DOL plan is strict (~20 calls/day) — the worker self-governs with a hard
# MAX_API_CALLS=5 circuit breaker. NEVER commit a real key (DOL prohibits sharing).
DOL_API_KEY=

# ── Optional worker overrides (defaults are baked into the worker) ─────────
# SAM_OPPS_LANCE_URI=s3://sam-gov-opps/active/
# SAM_OPPS_CSV_URL=

# ── SEC Form ADV worker (pipelines/sec_adv) ────────────────────────────────
# SEC FOIA compliance: every sec.gov request declares this UA (an undeclared agent is
# 403'd at the SEC edge). Name a real contact. Default is baked into the worker.
# SEC_USER_AGENT=Core-X Data Engine (compliance@yourdomain.com)
# SEC_ADV_FOIA_URL=https://www.sec.gov/foia-services/frequently-requested-documents/form-adv-data
# SEC_ADV_PART1_LANCE_URI=s3://data-sink/active/sec_adv_part1/
# SEC_ADV_W_LANCE_URI=s3://data-sink/active/sec_adv_w/

# ── PropertyRadar worker (pipelines/propertyradar) — BILLABLE feed ──────────
# Quota-governed property/owner harvest. The Bearer token gates the free preview AND the
# billable retrieval (Modal secret: propertyradar-api). The two-stage Quota Governor never
# issues Purchase=1 until the free preview's totalResultCount clears --max-allowed-spend.
PROPERTYRADAR_API_TOKEN=
# Optional worker overrides (defaults baked into the worker):
# PROPERTYRADAR_API_BASE=https://api.propertyradar.com
# PROPERTYRADAR_PREVIEW_FIELDS=RadarID          # Stage-1 free preview Fields
# PROPERTYRADAR_PURCHASE_FIELDS=All             # Stage-3 billable Fields
# PROPERTYRADAR_PAGE_LIMIT=1000                 # billable pagination Limit (PR max 1000)
# PROPERTYRADAR_PROPERTY_LANCE_URI=s3://data-sink/active/propertyradar_property_lance/
# PROPERTYRADAR_PERSON_LANCE_URI=s3://data-sink/active/propertyradar_person_lance/

# ── Shovels.ai worker (pipelines/shovels) ──────────────────────────────────
# Billable REST API (X-API-Key; §2). Worker reads the key from the Modal secret
# "shovels-api". Create it once from Doppler:
#   modal secret create shovels-api SHOVELS_API_KEY=<key>
SHOVELS_API_KEY=
# Optional overrides (defaults baked into the worker):
# SHOVELS_BASE_URL=https://api.shovels.ai/v2
# SHOVELS_PERMITS_LANCE_URI=s3://data-sink/active/shovels_permits/
# SHOVELS_CONTRACTORS_LANCE_URI=s3://data-sink/active/shovels_contractors/
# SHOVELS_EMPLOYEES_LANCE_URI=s3://data-sink/active/shovels_employees/
# SHOVELS_RESIDENTS_LANCE_URI=s3://data-sink/active/shovels_residents/
# SHOVELS_GEO_LANCE_URI=s3://data-sink/active/shovels_geo/
# SHOVELS_TAGS_LANCE_URI=s3://data-sink/active/shovels_tags/

# ── OSHA sniper worker (pipelines/osha) ────────────────────────────────────
# Quota-safe daily severe-violation triggers. Defaults are baked into the worker;
# override only to retarget the DOL endpoint slugs, the Lance sink, or field scope.
# OSHA_TRIGGERS_LANCE_URI=s3://data-sink/active/osha_daily_triggers/
# DOL_API_BASE=https://apiprod.dol.gov/v4/get
# OSHA_AGENCY=OSHA
# OSHA_INSPECTION_ENDPOINT=inspection
# OSHA_VIOLATION_ENDPOINT=violation
# OSHA_REQUEST_ALL_FIELDS=        # set to 1 to drop the `fields` projection (request all columns)

# ── CO UCC companions migration worker (pipelines/co_ucc/companions_bulk.py) ─
# Migrates the Gen-2 CO UCC party/collateral streams into the Gen-3 active sink.
# Reads s3://dex-raw-landing-zone/ucc/state=CO/stream={debtors,secured_parties,collateral}/
# and writes native Lance with a file_id BTREE. Defaults are baked into the worker;
# override only to retarget the source bucket or the three Gen-3 sinks.
# UCC_CO_SOURCE_BUCKET=dex-raw-landing-zone
# UCC_CO_DEBTORS_URI=s3://data-sink/active/ucc_co_debtors/
# UCC_CO_SECURED_PARTIES_URI=s3://data-sink/active/ucc_co_secured_parties/
# UCC_CO_COLLATERAL_URI=s3://data-sink/active/ucc_co_collateral/

# ── GTM minimal materialization worker (pipelines/gtm/companies_people_bulk.py) ─
# Reads the legacy DEX Postgres gtm.companies / gtm.people (via the DuckDB postgres
# scanner, READ_ONLY) and materializes minimal Gen-3 Lance datasets with BTREE indexes
# (normalized_domain on companies; company_id + normalized_domain on people).
# Source DSN → Modal secret "dex-postgres" (DEX pooled / Supavisor session-mode URL):
#   modal secret create dex-postgres DEX_DB_URL_POOLED="$(doppler secrets get DEX_DB_POOLED_URL --project hq-x --config prd --plain)"
DEX_DB_URL_POOLED=
# Defaults are baked into the worker; override only to retarget the two Gen-3 sinks.
# GTM_COMPANIES_URI=s3://data-sink/active/companies/
# GTM_PEOPLE_URI=s3://data-sink/active/people/
