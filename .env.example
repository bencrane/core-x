# core-x — Gen-3 data-plane environment variables.
#
# The authoritative source is Doppler + Modal Secrets, NOT a committed .env.
# This file documents variable names for local/debug runs only. Runtime wiring:
#   - Trigger.dev task env (control plane): MODAL_DISPATCHER_URL, MODAL_KEY, MODAL_SECRET
#   - Modal secret "r2-credentials" (worker → R2):    R2_*
#   - Modal secret "hqx-postgres"   (worker → ops.*): HQX_DB_URL_POOLED

# ── Control plane → Universal Dispatcher (set in the Trigger project env) ──
# The single proxy-authed Modal endpoint + its proxy-auth token pair.
MODAL_DISPATCHER_URL=
MODAL_KEY=
MODAL_SECRET=

# ── Data plane → Cloudflare R2 (Modal secret: r2-credentials) ──────────────
# Lance system-of-record storage. Supply R2_ENDPOINT directly, or R2_ACCOUNT_ID
# to derive https://<account>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Data plane → Postgres ops.* state (Modal secret: hqx-postgres) ─────────
# Worker writes terminal run rows to ops.sam_opps_canonical_runs (pooled DSN).
HQX_DB_URL_POOLED=

# ── Optional worker overrides (defaults are baked into the worker) ─────────
# SAM_OPPS_LANCE_URI=s3://sam-gov-opps/active/
# SAM_OPPS_CSV_URL=

# ── SEC Form ADV worker (pipelines/sec_adv) ────────────────────────────────
# SEC FOIA compliance: every sec.gov request declares this UA (an undeclared agent is
# 403'd at the SEC edge). Name a real contact. Default is baked into the worker.
# SEC_USER_AGENT=Core-X Data Engine (compliance@yourdomain.com)
# SEC_ADV_FOIA_URL=https://www.sec.gov/foia-services/frequently-requested-documents/form-adv-data
# SEC_ADV_PART1_LANCE_URI=s3://data-sink/active/sec_adv_part1/
# SEC_ADV_W_LANCE_URI=s3://data-sink/active/sec_adv_w/

# ── Shovels.ai worker (pipelines/shovels) ──────────────────────────────────
# Billable REST API (X-API-Key; §2). Worker reads the key from the Modal secret
# "shovels-api". Create it once from Doppler:
#   modal secret create shovels-api SHOVELS_API_KEY=<key>
SHOVELS_API_KEY=
# Optional overrides (defaults baked into the worker):
# SHOVELS_BASE_URL=https://api.shovels.ai/v2
# SHOVELS_PERMITS_LANCE_URI=s3://data-sink/active/shovels_permits/
# SHOVELS_CONTRACTORS_LANCE_URI=s3://data-sink/active/shovels_contractors/
# SHOVELS_EMPLOYEES_LANCE_URI=s3://data-sink/active/shovels_employees/
# SHOVELS_RESIDENTS_LANCE_URI=s3://data-sink/active/shovels_residents/
# SHOVELS_GEO_LANCE_URI=s3://data-sink/active/shovels_geo/
# SHOVELS_TAGS_LANCE_URI=s3://data-sink/active/shovels_tags/
