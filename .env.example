# core-x — Gen-3 data-plane environment variables.
#
# The authoritative source is Doppler + Modal Secrets, NOT a committed .env.
# This file documents variable names for local/debug runs only. Runtime wiring:
#   - Trigger.dev task env (control plane): MODAL_DISPATCHER_URL, MODAL_KEY, MODAL_SECRET
#   - Modal secret "r2-credentials" (worker → R2):    R2_*
#   - Modal secret "hqx-postgres"   (worker → ops.*): HQX_DB_URL_POOLED

# ── Control plane → Universal Dispatcher (set in the Trigger project env) ──
# The single proxy-authed Modal endpoint + its proxy-auth token pair.
MODAL_DISPATCHER_URL=
MODAL_KEY=
MODAL_SECRET=

# ── Data plane → Cloudflare R2 (Modal secret: r2-credentials) ──────────────
# Lance system-of-record storage. Supply R2_ENDPOINT directly, or R2_ACCOUNT_ID
# to derive https://<account>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Data plane → Postgres ops.* state (Modal secret: hqx-postgres) ─────────
# Worker writes terminal run rows to ops.sam_opps_canonical_runs (pooled DSN).
HQX_DB_URL_POOLED=

# ── Optional worker overrides (defaults are baked into the worker) ─────────
# SAM_OPPS_LANCE_URI=s3://sam-gov-opps/active/
# SAM_OPPS_CSV_URL=
